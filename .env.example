# --- API ---
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
LOG_LEVEL=info

# Origin of the web app (CORS + Better Auth trusted origin)
WEB_URL=http://localhost:3000

# --- Infra (matches docker-compose.yml) ---
DATABASE_URL=postgres://findremind:findremind@localhost:5432/findremind
ELASTICSEARCH_URL=http://localhost:9200
REDIS_URL=redis://localhost:6379

# --- Auth (Better Auth) ---
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3001

# --- AI ---
# 32-byte key used to encrypt user-provided provider API keys at rest
# generate with: openssl rand -base64 32
AI_KEYS_ENCRYPTION_KEY=change-me
# default local provider (users can add OpenAI/Anthropic/Gemini in Settings)
OLLAMA_BASE_URL=http://localhost:11434

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
